rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: verifica se o usuário autenticado possui role 'admin'
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // USUÁRIOS (/users/{uid})
    // ==========================================
    // RLS Restrita: cada usuário só pode ler e gerenciar seus próprios dados.
    // Impede enumeração de emails ou leitura de dados privados por terceiros.
    // Criação: forçada obrigatoriamente como 'player' (impede injeção de role 'admin').
    // Atualização: apenas dono ou admin; bloqueia edição direta de role, email, rublos e atributos base.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null 
        && request.auth.uid == uid 
        && request.resource.data.role == 'player';
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['character']) &&
          request.resource.data.character.diff(resource.data.character).affectedKeys().hasNone(['rublos', 'baseAttributes'])
        )
      );
    }
    
    // ==========================================
    // ÍNDICE PÚBLICO LEVE (/players_index/{uid})
    // ==========================================
    // Usado para listagens públicas (sobreviventes, rádio) sem expor email ou dados confidenciais.
    // Escrita estritamente pelo próprio dono ou admin, travado com role player.
    match /players_index/{uid} {
      allow read: if true;
      allow write: if request.auth != null 
        && (request.auth.uid == uid || isAdmin())
        && request.resource.data.role == 'player';
    }

    // ==========================================
    // FICHAS PRÉ-PRONTAS (/pre_made_sheets/{sheetId})
    // ==========================================
    match /pre_made_sheets/{sheetId} {
      allow read: if true;
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.available == true &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['available', 'claimedBy', 'claimedByName', 'claimedAt'])
        )
      );
    }

    // ==========================================
    // LOJAS (/shops/{shopId})
    // ==========================================
    // Jogadores autenticados só podem atualizar o estoque (itemsForSale) decorrente de compra/venda.
    match /shops/{shopId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itemsForSale'])
      );
    }

    // ==========================================
    // ARMAZENAMENTOS (/storages/{storageId})
    // ==========================================
    // Baús, cofres, veículos e depósitos.
    // Atualização restrita aos itens armazenados e ao log de movimentação.
    match /storages/{storageId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'activityLog'])
      );
    }

    // ==========================================
    // LOCAÇÕES (/locations/{locationId})
    // ==========================================
    match /locations/{locationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ==========================================
    // CONFIGURAÇÕES GLOBAIS
    // ==========================================
    match /home_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /rules_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /game_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /map_config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ==========================================
    // DADOS E HISTÓRICO DE DADOS (/dice_rolls/{rollId})
    // ==========================================
    match /dice_rolls/{rollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.playerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ==========================================
    // CATÁLOGO E PRESETS DE ITENS
    // ==========================================
    match /items_db/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /loot_collections/{colId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ==========================================
    // CALENDÁRIO E COMBATE ATIVO
    // ==========================================
    match /calendar_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /active_combats/{combatId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ==========================================
    // ATIVIDADES E PRODUÇÃO (Plantação, Galinheiro)
    // ==========================================
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /activity_states/{stateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.plantedBy == request.auth.uid || isAdmin()
      );
    }

    // ==========================================
    // RÁDIO
    // ==========================================
    match /radio_transmissions/{transId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }

    match /radio_auto_messages/{msgId} {
      allow read: if request.auth != null;
      allow create, delete, update: if request.auth != null && isAdmin();
    }

    match /radio_points/{pointId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ==========================================
    // DEFESA DA BASE
    // ==========================================
    match /base_defense/{defenseId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /base_defense_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isAdmin();
      allow update, delete: if false;
    }

    // ==========================================
    // CULINÁRIA E ÁGUA
    // ==========================================
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /water_sources/{sourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ==========================================
    // FORMULÁRIOS
    // ==========================================
    match /custom_forms/{formId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ==========================================
    // FÓRUM DA COMUNIDADE
    // ==========================================
    match /forum_topics/{topicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.authorUid == request.auth.uid || isAdmin()
      );
    }

    // ==========================================
    // EVOLUÇÃO DO ACAMPAMENTO
    // ==========================================
    match /camp_structures/{structureId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentResources', 'contributors', 'lastContributedAt'])
      );
    }

    match /camp_missions/{missionId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['contributors', 'currentAmount', 'completedBy', 'completedAt'])
      );
    }

    match /camp_config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Ciclos e limites por jogador: verificação estrita de dono
    match /camp_player_cycles/{recordId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && isAdmin();
    }

    match /camp_mission_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }

    match /camp_evolution_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }

  }
}
